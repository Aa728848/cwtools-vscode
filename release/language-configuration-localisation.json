{
    "comments": {
        "lineComment": "#"
    },
    "brackets": [
        ["[", "]"]
    ],
    "autoClosingPairs": [
        {
            "open": "\"",
            "close": "\"",
            "notIn": ["string", "comment"]
        },
        ["[", "]"]
    ],
    "surroundingPairs": [
        ["\"", "\""],
        ["[", "]"],
        ["$", "$"]
    ],
    "wordPattern": "\\u00a7[A-Za-z0-9!%-]?|\\u00a3|\\$?[^\\s\\u00a7\\u00a3$\\\"'\\[\\]{}(),;!?=<>#]+\\$?"
}
