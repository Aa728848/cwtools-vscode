{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwtools.dev/benchmarks/phase0-baseline.schema.json",
  "title": "CWTools Phase 0 baseline manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "workspace",
    "server",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "server": {
      "type": "string",
      "minLength": 1
    },
    "vsix": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "params"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "params": {}
        }
      }
    },
    "gameId": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
