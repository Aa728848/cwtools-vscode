  "notifications": [
    {
      "name": "didFocusFile",
      "direction": "client-to-server",
      "payload": "{ uri: string }"
    },
    {
      "name": "loadingBar",
      "direction": "server-to-client",
      "payload": "{ enable: boolean, value: string, percentage?: number }"
    },
    {
      "name": "debugBar",
      "direction": "server-to-client",
      "payload": "{ enable: boolean, value: string }"
    },
    {
      "name": "createVirtualFile",
      "direction": "server-to-client",
      "payload": "{ uri: string, fileContent: string }"
    },
    {
      "name": "promptReload",
      "direction": "server-to-client",
      "payload": "string"
    },
    {
      "name": "forceReload",
      "direction": "server-to-client",
      "payload": "string"
    },
    {
      "name": "vanillaCacheGenerated",
      "direction": "server-to-client",
      "payload": "unknown"
    },
    {
      "name": "cwtools/serverReady",
      "direction": "server-to-client",
      "payload": "unknown"
    },
    {
      "name": "promptVanillaPath",
      "direction": "server-to-client",
      "payload": "string"
    },
    {
      "name": "updateFileList",
      "direction": "server-to-client",
      "payload": "{ fileList: FileListItem[] }"
    },
    {
      "name": "monitorLog",
      "direction": "server-to-client",
      "payload": "{ category?: string, message: string, timestamp?: string }"
    },
    {
      "name": "cwtools/validationComplete",
      "direction": "server-to-client",
      "payload": "unknown"
    },
    {
      "name": "completionRefresh",
      "direction": "server-to-client",
      "payload": "{ uri: string, line: number, character: number, version: number }"
    }
  ],
  "invariants": [
    "stdout contains framed JSON-RPC only; logs use stderr",
    "all LSP Position and Range values use UTF-16 code units",
    "semantic token type and modifier order is an integer ABI",
    "getValidationStatus is lock-free and preserves readiness/epoch/freshness semantics",
    "unknown executeCommand values default to write locking",
    "MCP remains read-only"
  ]
}
