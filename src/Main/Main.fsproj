
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="cwtools.local.props" Condition="Exists('cwtools.local.props')" />

  <PropertyGroup>
    <AssemblyName>CWTools Server</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <Tailcalls>true</Tailcalls>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Self-contained only when a RID is supplied (e.g. publish -r linux-x64); a plain
         `dotnet build` with no RID stays framework-dependent so it does not error with
         NETSDK1031. Release packaging (package.ps1) always passes an explicit -r. -->
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Languages\Languages.csproj" />
    <RuntimeHostConfigurationOption Include="System.GC.NoAffinitize" Value="true" />

    <ProjectReference Include="..\LSP\LSP.fsproj" />
    <ProjectReference Condition="'$(UseLocalCwtools)' != 'True'" Include="..\..\submodules\cwtools\CWTools\CWTools.fsproj" />
    <ProjectReference Condition="'$(UseLocalCwtools)' == 'True'" Include="$(CwtoolsPath)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="PosHelper.fs" />
    <Compile Include="CwtLanguageFeatures.fs" />
    <Compile Include="Serialize.fs" />
    <Compile Include="Git.fs" />
    <Compile Include="LanguageServerFeatures.fs" />
    <Compile Include="GameLoader.fs" />
    <Compile Include="CompletionText.fs" />
    <Compile Include="Completion.fs" />
    <Compile Include="CompletionFallbackPolicy.fs" />
    <Compile Include="GraphTypes.fs" />
    <Compile Include="SemanticGraph.fs" />
    <Compile Include="InlineGraph.fs" />
    <Compile Include="PdxEventSemantics.fs" />
    <Compile Include="PdxFlowAnalysis.fs" />
    <Compile Include="ProjectKnowledge.fs" />
    <Compile Include="DiagnosticMerge.fs" />
    <Compile Include="PdxFolding.fs" />
    <Compile Include="LocalisationPreview.fs" />
    <Compile Include="SemanticDelta.fs" />
    <Compile Include="SemanticDirectoryCatalog.fs" />
    <Compile Include="PdxFragmentValidation.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
</Project>
