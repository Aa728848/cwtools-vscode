{
	"compilerOptions": {
		"noImplicitReturns": true,
		"target": "es2020",
		"module": "commonjs",
		"moduleResolution": "node",
		"baseUrl": ".",
		"paths": { "cwtools-shared/editors": ["node_modules/cwtools-shared/dist/editors/index.d.ts"] },
		"rootDir": "client",
		"outDir": "release/bin/client",
		"lib": [ "es2020", "dom" ],
		"sourceMap": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"include": [
		"client"
	],
	"exclude": [
		"node_modules",
		"server",
		".vscode-test"
	]
}
