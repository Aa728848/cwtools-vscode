{
  "schemaVersion": 1,
  "protocol": {
    "transport": "stdio",
    "framing": "Content-Length: N\\r\\n\\r\\n<payload>",
    "positionEncoding": "utf-16",
    "maxFrameBytes": 16777216,
    "lifecycle": [
      "initialize",
      "initialized",
      "shutdown",
      "exit",
      "stdin-eof",
      "$/cancelRequest"
    ],
    "arguments": [
      "--stdio"
    ],
    "environment": [
      "CWTOOLS_SERVER_INSTANCE_ID"
    ]
  },
  "initialization": {
    "options": [
      "language",
      "uiLanguage",
      "isVanillaFolder",
      "rulesCache",
      "bundledRulesPath",
      "rules_version",
      "defaultRepoPath",
      "repoPath",
      "diagnosticLogging"
    ],
    "gameIds": [
      "stellaris",
      "hoi4",
      "eu4",
      "ck2",
      "imperator",
      "vic2",
      "ck3",
      "vic3",
      "eu5",
      "cwt",
      "paradox"
    ],
    "clientCapabilityBranches": [
      "textDocument.completion.completionItem.insertReplaceSupport"
    ]
  },
  "capabilities": {
    "textDocumentSync": {
      "openClose": true,
      "change": "incremental",
      "willSave": true,
      "willSaveWaitUntil": false,
      "saveIncludeText": true
    },
    "providers": [
      "hover",
      "signatureHelp",
      "definition",
      "references",
      "documentHighlight",
      "documentFormatting",
      "completion",
      "codeAction",
      "codeLens",
      "documentLink",
      "documentSymbol",
      "workspaceSymbol",
      "inlayHint",
      "foldingRange",
      "selectionRange",
      "callHierarchy",
      "rename",
      "semanticTokens"
    ],
    "completionTriggerCharacters": [
      ".",
      "|",
      "$",
      "\"",
      "=",
      "{",
      ":"
    ],
    "signatureTriggerCharacters": [
      "(",
      ","
    ],
    "semanticTokens": {
      "tokenTypes": [
        "namespace",
        "type",
        "function",
        "variable",
        "parameter",
        "property",
        "enumMember",
        "keyword",
        "number",
        "string",
        "comment",
        "operator",
        "macro",
        "decorator"
      ],
      "tokenModifiers": [
        "declaration",
        "definition",
        "readonly",
        "inactive"
      ],
      "full": true,
      "range": false,
      "delta": true
    }
  },
  "commands": [
    {
      "name": "cacheVanilla",
      "effect": "write",
      "lockFree": false,
      "advertised": true,
      "handler": true
