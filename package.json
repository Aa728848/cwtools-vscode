{
    "name": "cwtools-vscode",
    "version": "2.17.0",
    "scripts": {
        "compile": "tsc -p ./.config/tsconfig.extension.json && rollup -c",
        "build:docs": "node tools/build-github-docs.js && node tools/build-release-readme.js",
        "generate:mcp-schema": "node tools/generate-mcp-schema.cjs",
        "check:mcp-schema": "node tools/generate-mcp-schema.cjs --check",
        "pack": "powershell -ExecutionPolicy Bypass -File ./package.ps1",
        "pack:install": "powershell -ExecutionPolicy Bypass -File ./package.ps1 -Install",
        "pack:quick": "powershell -ExecutionPolicy Bypass -File ./package.ps1 -SkipServer -Install",
        "pack:release": "powershell -ExecutionPolicy Bypass -File ./package.ps1 -Publish",
        "rules:stellaris": "node tools/rules-sync/stellaris-rules-sync.js",
        "rules:stellaris:scan": "node tools/rules-sync/stellaris-rules-sync.js scan",
        "rules:stellaris:check": "node tools/rules-sync/stellaris-rules-sync.js check",
        "rules:stellaris:update": "node tools/rules-sync/stellaris-rules-sync.js update",
        "rules:stellaris:report": "node tools/rules-sync/stellaris-rules-sync.js report",
        "rules:stellaris:contracts": "node tools/rules-sync/stellaris-rules-sync.js contracts",
        "test": "npm run compile && tsc -p ./.config/tsconfig.test-build.json && node tools/copy-test-fixtures.js && vscode-test --config ./.config/vscode-test.js",
        "test:shader-lsp": "npm run compile && tsc -p ./.config/tsconfig.shader-test.json && vscode-test --config ./.config/vscode-test.shader.js",
        "test:overlay-e2e": "node tools/run-overlay-e2e.cjs",
        "test:watch": "node tools/run-watch-test.cjs",
        "test:unit": "ts-mocha -p tsconfig.json \"client/test/unit/**/*.test.ts\" && npm run test:rules-sync",
        "test:rules-sync": "ts-mocha -p tools/rules-sync/tsconfig.test.json \"tools/rules-sync/**/*.test.ts\"",
        "test:coverage": "c8 npm run test:unit",
        "test:fsx": "node tools/run-all-fsx-tests.cjs",
        "typecheck:test": "tsc -p tsconfig.json --noEmit",
        "baseline:ai-context": "node tools/perf/ai-context-baseline.mjs",
        "lint": "eslint client/",
        "check:release": "node tools/check-release.js",
        "verify": "npm run lint && npm run compile && npm run typecheck:test && npm run test:unit && npm run check:release -- --skip-compile --skip-test",
        "test:cwt-lsp": "npm run compile && tsc -p ./.config/tsconfig.cwt-test.json && vscode-test --config ./.config/vscode-test.cwt.js",
        "test:cwt-game-lsp": "npm run compile && tsc -p ./.config/tsconfig.cwt-test.json && vscode-test --config ./.config/vscode-test.cwt-game.js"
    },
    "dependencies": {
        "google-translate-api-x": "^10.7.2",
        "quickjs-emscripten": "^0.31.0",
        "socks": "^2.8.10",
        "sql.js": "^1.14.1",
        "undici": "^6.28.1",
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@eslint/compat": "^1.3.1",
        "@eslint/js": "^9.32.0",
        "@popperjs/core": "^2.11.8",
        "@rollup/plugin-commonjs": "^28.0.6",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@rollup/plugin-replace": "^6.0.2",
        "@types/chai": "^4.3.20",
        "@types/cytoscape-popper": "^2.0.4",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.9",
        "@types/sinon": "17.0.4",
        "@types/sql.js": "^1.4.11",
        "@types/three": "^0.184.1",
        "@types/vscode": "^1.90.0",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^3.6.0",
        "c8": "^9.1.0",
        "chai": "^4.5.0",
        "cytoscape": "^3.32.1",
        "cytoscape-elk": "github:jfstephe/cytoscape.js-elk#bb1d03ea4f303b60c0c0fe8aea65e95154cb9dbe",
        "cytoscape-popper": "^2.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^9.32.0",
        "glob": "^11.0.3",
        "mermaid": "^11.16.0",
        "mocha": "^11.7.1",
        "rollup-plugin-hypothetical": "^2.1.0",
        "rollup-plugin-typescript2": "^0.36.0",
        "sinon": "21.0.0",
        "three": "^0.184.0",
        "tippy.js": "^6.3.7",
        "ts-mocha": "^11.1.0",
        "ts-morph": "^28.0.0",
        "tslib": "^2.8.1",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.38.0"
    },
    "engines": {
        "vscode": "^1.90.0"
    }
}
