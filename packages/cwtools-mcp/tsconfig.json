{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["es2020"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2020"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/test/**/*.ts", "dist", "node_modules"]
}
